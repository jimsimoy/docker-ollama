# Copy this file to .env and adjust values before running docker-compose up

OLLAMA_HOST_BIND=127.0.0.1
OLLAMA_HOST_PORT=11435
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MEMORY_LIMIT=6g
OLLAMA_MODEL=kimi-k2:1t-cloud

# API key — leave empty to disable, or run ./generate-api-key.sh to set one
OLLAMA_API_KEY=

# GPU (NVIDIA only — requires nvidia-container-toolkit on host)
# NVIDIA_VISIBLE_DEVICES=all
